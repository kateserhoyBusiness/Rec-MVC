<div>
  <a href="/eventos" style="display: inline-block; margin-bottom: 2rem; color: #6366f1; text-decoration: none;">← Voltar para Eventos</a>

  <div class="evento-detalhe">
    <h1><%= evento.titulo %></h1>

    <div class="evento-meta">
      <div class="meta-item">
        <strong>👤 Organizador</strong>
        <p><%= evento.organizador_nome %></p>
      </div>
      <div class="meta-item">
        <strong>📅 Data e Hora</strong>
        <p><%= new Date(evento.data_evento).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
      </div>
      <% if (evento.local) { %>
        <div class="meta-item">
          <strong>📍 Local</strong>
          <p><%= evento.local %></p>
        </div>
      <% } %>
    </div>

    <% if (evento.descricao) { %>
      <div class="evento-descricao-full">
        <h3 style="margin-top: 0; margin-bottom: 1rem; color: #1f2937;">Sobre este evento</h3>
        <p><%= evento.descricao %></p>
      </div>
    <% } %>

    <div class="evento-actions">
      <% if (typeof usuario !== 'undefined' && usuario.userId) { %>
        <% if (evento.organizador_id === usuario.userId) { %>
          <a href="/eventos/<%= evento.id %>/editar" class="btn btn-warning">✏️ Editar Evento</a>
          <form method="POST" action="/eventos/<%= evento.id %>/excluir" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja excluir este evento?');">
            <button type="submit" class="btn btn-danger">🗑️ Excluir Evento</button>
          </form>
        <% } else if (usuario.tipo === 'participante' && !usuarioJaInscrito) { %>
          <form method="POST" action="/inscricoes/<%= evento.id %>" style="display: inline;">
            <button type="submit" class="btn btn-success">✅ Se Inscrever</button>
          </form>
        <% } else if (usuarioJaInscrito) { %>
          <div class="inscrito-badge">
            ✓ Você está inscrito neste evento
          </div>
        <% } %>
      <% } else { %>
        <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 1rem; border-radius: 6px; color: #78350f;">
          <strong>Faça login para participar</strong><br>
          <a href="/auth/login" class="btn btn-primary btn-sm" style="margin-top: 0.5rem;">Fazer Login</a>
        </div>
      <% } %>
    </div>
  </div>

  <div class="inscricoes-list">
    <h2>👥 Inscrições (<%= inscricoes.length %>)</h2>
    <% if (inscricoes.length > 0) { %>
      <% inscricoes.forEach(inscricao => { %>
        <div class="inscricao-item">
          <div>
            <p><strong><%= inscricao.participante_nome %></strong></p>
            <p style="color: #6b7280;"><%= inscricao.email %></p>
            <small style="color: #9ca3af;">Inscrito em <%= new Date(inscricao.data_inscricao).toLocaleDateString('pt-BR') %></small>
          </div>
          <% if (typeof usuario !== 'undefined' && usuario.userId === evento.organizador_id) { %>
            <div class="inscricao-actions">
              <form method="POST" action="/inscricoes/<%= inscricao.id %>/remover" style="display: inline;" onsubmit="return confirm('Remover inscrição?');">
                <input type="hidden" name="eventoId" value="<%= evento.id %>">
                <button type="submit" class="btn btn-danger btn-sm">Remover</button>
              </form>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align: center; padding: 2rem; color: #6b7280;">
        <p>Nenhuma inscrição ainda. Seja o primeiro a se inscrever!</p>
      </div>
    <% } %>
  </div>
</div>
