<h1>Eventos</h1>

<% if (typeof usuario !== 'undefined' && usuario.tipo === 'organizador') { %>
  <a href="/eventos/novo" style="display: inline-block; margin-bottom: 2rem; padding: 0.75rem 1.5rem; background-color: #27ae60; color: white; text-decoration: none; border-radius: 4px;">+ Criar Novo Evento</a>
<% } %>

<% if (typeof eventos !== 'undefined' && eventos.length > 0) { %>
  <div class="eventos-grid">
    <% eventos.forEach(evento => { %>
      <div class="evento-card">
        <div class="evento-card-content">
          <h3><%= evento.titulo %></h3>
          <p><strong>Organizador:</strong> <%= evento.organizador_nome %></p>
          <p><strong>Data:</strong> <%= new Date(evento.data_evento).toLocaleDateString('pt-BR', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %></p>
          <% if (evento.local) { %>
            <p><strong>Local:</strong> <%= evento.local %></p>
          <% } %>
          <p><%= evento.descricao ? evento.descricao.substring(0, 100) + '...' : 'Sem descrição' %></p>
          <a href="/eventos/<%= evento.id %>">Ver Detalhes</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="erro">
    <p>Nenhum evento cadastrado.</p>
  </div>
<% } %>
