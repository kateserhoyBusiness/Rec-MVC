<div>
  <h1><%= evento ? '✏️ Editar Evento' : '✨ Criar Novo Evento' %></h1>

  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="alert alert-danger">
      <%= erro %>
    </div>
  <% } %>

  <form method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="titulo" class="required">Título do Evento</label>
        <input type="text" id="titulo" name="titulo" value="<%= evento ? evento.titulo : '' %>" placeholder="Ex: Workshop de Node.js" maxlength="150" required>
        <small style="color: #6b7280;">Máximo 150 caracteres</small>
      </div>
      <div class="form-group">
        <label for="local">Local</label>
        <input type="text" id="local" name="local" value="<%= evento ? evento.local : '' %>" placeholder="Ex: São Paulo, SP">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="data_evento" class="required">Data e Hora</label>
        <input type="datetime-local" id="data_evento" name="data_evento" value="<%= evento ? evento.data_evento.slice(0, 16) : '' %>" required>
      </div>
    </div>

    <div class="form-group">
      <label for="descricao">Descrição Detalhada</label>
      <textarea id="descricao" name="descricao" placeholder="Descreva seu evento, objetivo, público-alvo, programação, etc..."><%= evento ? evento.descricao : '' %></textarea>
    </div>

    <div class="form-actions">
      <a href="/eventos" class="btn btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= evento ? '💾 Atualizar Evento' : '✨ Criar Evento' %></button>
    </div>
  </form>
</div>
