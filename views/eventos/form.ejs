<h1><%= evento ? 'Editar Evento' : 'Criar Novo Evento' %></h1>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="erro"><%= erro %></div>
<% } %>

<form method="POST">
  <div class="form-group">
    <label for="titulo">Título do Evento *</label>
    <input type="text" id="titulo" name="titulo" value="<%= evento ? evento.titulo : '' %>" required maxlength="150">
  </div>
  <div class="form-group">
    <label for="descricao">Descrição</label>
    <textarea id="descricao" name="descricao"><%= evento ? evento.descricao : '' %></textarea>
  </div>
  <div class="form-group">
    <label for="data_evento">Data e Hora do Evento *</label>
    <input type="datetime-local" id="data_evento" name="data_evento" value="<%= evento ? evento.data_evento.slice(0, 16) : '' %>" required>
  </div>
  <div class="form-group">
    <label for="local">Local</label>
    <input type="text" id="local" name="local" value="<%= evento ? evento.local : '' %>">
  </div>
  <div>
    <button type="submit"><%= evento ? 'Atualizar Evento' : 'Criar Evento' %></button>
    <a href="/eventos" style="display: inline-block; margin-left: 1rem; padding: 0.75rem 1.5rem; background-color: #95a5a6; color: white; text-decoration: none; border-radius: 4px;">Cancelar</a>
  </div>
</form>
