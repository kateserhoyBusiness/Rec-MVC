<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EventHub - Gestão de Eventos</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- NAVBAR PREMIUM -->
  <nav class="navbar">
    <div class="navbar-container">
      <a href="/eventos" class="navbar-brand">
        <span class="brand-icon">✨</span>
        <span class="brand-text">EventHub</span>
      </a>
      
      <div class="navbar-menu">
        <a href="/eventos" class="nav-link">
          <span>📅</span> Eventos
        </a>
        
        <% if (typeof usuario !== 'undefined' && usuario.userId) { %>
          <% if (usuario.tipo === 'organizador') { %>
            <a href="/eventos/novo" class="nav-link nav-link-create">
              <span>➕</span> Criar Evento
            </a>
          <% } %>
          
          <div class="nav-profile">
            <div class="profile-avatar">
              <%= usuario.nome.charAt(0).toUpperCase() %>
            </div>
            <span class="profile-name"><%= usuario.nome %></span>
            <a href="/auth/logout" class="nav-logout">Sair</a>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link">🔐 Login</a>
          <a href="/auth/registro" class="nav-link nav-link-primary">
            <span>✍️</span> Registrar
          </a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="page-wrapper">
    <div class="container">
      <%- body %>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-content">
      <p>EventHub © 2026 - Plataforma Moderna de Gestão de Eventos</p>
      <div class="footer-links">
        <a href="#privacidade">Privacidade</a> • 
        <a href="#termos">Termos</a> • 
        <a href="#contato">Contato</a>
      </div>
    </div>
  </footer>
</body>
</html>
